# Input data. Third-party scientific data — an atomic mass evaluation, charge distribution and
# shell correction systematics, a resonance parameter library, and experimental fragment mass
# yields. None of it originates with this package and the licence on this code does not extend
# to it, so it is held locally and documented rather than redistributed. data/README.md records
# what each file is and where to obtain it, and is tracked.
#
# The one exception is the atomic mass evaluation, published openly and small enough to ship.
# Keeping it means the reference tests run on a bare clone.
/data/*
!/data/README.md
!/data/mass_excess/
/data/mass_excess/*
!/data/mass_excess/ame2020.dat

# Pipeline output. Each run writes its tables and metadata under its own system directory; the
# two figures the README shows are tracked, and everything else a run draws is not.
/results/
/figures/*
!/figures/multiplicity_vs_experiment.png
!/figures/multiplicity_vs_experiment.pdf
!/figures/prompt_neutron_spectrum.png
!/figures/prompt_neutron_spectrum.pdf

# Libraries do not pin a manifest; each environment resolves against [compat].
Manifest.toml

# Julia artifacts
/docs/build/
/docs/site/
*.cov
*.jl.mem
LocalPreferences.toml

# Editor and OS
.vscode/
.idea/
*~
.DS_Store
